

int main() {
    int choice, num;
    string str;
    srand(time(0));
    
    do {
        cout << "\nConversion Menu:\n";
        cout << "1. Convert Decimal to Binary\n";
        cout << "2. Convert Binary to Decimal\n";
        cout << "3. Convert Decimal to Hexadecimal\n";
        cout << "4. Convert Hexadecimal to Decimal\n";
        cout << "5. Demo (Generate and convert random integers)\n";
        cout << "6. Exit\n";
        cout << "Enter your choice (1-6): ";
        cin >> choice;
        
        switch(choice) {
            case 1: 
                cout << "Enter a decimal number: "; cin >> num;
                cout << "Binary: " << decToBin(num) << endl;
                break;
            case 2:
                cout << "Enter a binary number: "; cin >> str;
                cout << "Decimal: " << binToDec(str) << endl;
                break;
            case 3:
                cout << "Enter a decimal number: "; cin >> num;
                cout << "Hexadecimal: " << decToHex(num) << endl;
                break;
            case 4:
                cout << "Enter a hexadecimal number: "; cin >> str;
                cout << "Decimal: " << hexToDec(str) << endl;
                break;
            case 5:
                num = rand() % 100;
                cout << "Generated random number: " << num << endl;
                cout << "Binary: " << decToBin(num) << endl;
                break;
            case 6: 
                cout << "Exiting program." << endl;
                break;
            default: 
                cout << "Invalid choice." << endl;
        }
    } while(choice!= 6);
    return 0;
}
